{
  "name": "ayumad-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "content": "node --import tsx scripts/export-vault.ts",
    "predev": "npm run content",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "npm run content",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "validate": "npm run content && npm run check && npm test && npm run build",
    "sync": "node --import tsx scripts/sync-vault.ts --once",
    "watch": "node --import tsx scripts/sync-vault.ts --watch",
    "automation:install": "bash scripts/install-automation.sh",
    "automation:uninstall": "bash scripts/uninstall-automation.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "astro": "^7.1.6",
    "chokidar": "^4.0.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.15.21",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
