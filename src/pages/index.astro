---
import manifest from "../generated/manifest.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogPosts } from "../lib/blog";

const { documents, generatedAt } = manifest;
const sections = [
  {
    title: "Blog",
    href: "/blog/",
    description: "Edited essays about the projects, systems, and ideas developed here.",
    count: blogPosts.length,
  },
  {
    title: "Projects",
    href: "/projects/",
    description: "Things I am building or have built.",
    count: documents.filter((document) => document.section === "projects").length,
  },
  {
    title: "Systems",
    href: "/systems/",
    description: "My computers, homelab, audio setup, and how everything fits together.",
    count: documents.filter((document) => document.section === "systems").length,
  },
  {
    title: "Interests",
    href: "/interests/",
    description: "Technology, audio, photography, philosophy, media, and other things I care about.",
    count: documents.filter((document) => document.section === "interests").length,
  },
  {
    title: "Notes",
    href: "/library/",
    description: "Reference notes, lists, comparisons, and other details.",
    count: documents.filter((document) => document.section === "library").length,
  },
];
const recent = [...documents]
  .filter((document) => document.updated)
  .sort((a, b) => (b.updated || "").localeCompare(a.updated || ""))
  .slice(0, 8);
---
<BaseLayout
  title="Home"
  description="Ayush Madhukar’s public notes about projects, computers, audio, cameras, and other interests."
  generatedAt={generatedAt}
>
  <header class="plain-home-header">
    <h1>Blog + knowledge</h1>
    <p>
      The public writing layer of ayumad.me. Read finished essays in the Blog or explore
      the connected projects, systems, reference notes, and ideas exported from my Obsidian vault.
    </p>
    <form class="home-search" action="/explore/" method="get">
      <label for="home-search">Search my notes</label>
      <div><input id="home-search" name="q" type="search" placeholder="Search…" /><button type="submit">Search</button></div>
    </form>
  </header>

  <nav class="plain-section-list" aria-label="Sections">
    {sections.map((section) => (
      <a href={section.href}>
        <div><h2>{section.title}</h2><p>{section.description}</p></div>
        <span>{section.count}</span>
      </a>
    ))}
  </nav>

  <section class="plain-recent featured-writing">
    <div class="simple-heading"><h2>Latest essays</h2><a href="/blog/">View all writing</a></div>
    <ol>
      {blogPosts.slice(0, 4).map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>{post.title}</a>
          <span>{post.tags.slice(0, 2).join(" · ")}</span>
          <time datetime={post.date}>{post.date}</time>
        </li>
      ))}
    </ol>
  </section>

  <section class="plain-recent">
    <div class="simple-heading"><h2>Recently updated notes</h2><a href="/timeline/">View timeline</a></div>
    <ol>
      {recent.map((document) => (
        <li>
          <a href={`/notes/${document.slug}/`}>{document.title}</a>
          <span>{document.topic}</span>
          <time datetime={document.updated}>{document.updated}</time>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
