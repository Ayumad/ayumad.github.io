---
import manifest from "../generated/manifest.json";
import SectionPage from "../components/SectionPage.astro";
import type { PublicDocument } from "../types";
const documents = manifest.documents.filter((document) => document.section === "library") as PublicDocument[];
---
<SectionPage
  section="library"
  title="Notes"
  eyebrow="Notes"
  intro="Reference notes, inventories, comparisons, lists, and details that do not need their own section."
  documents={documents}
  generatedAt={manifest.generatedAt}
/>
