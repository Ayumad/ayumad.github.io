---
import manifest from "../generated/manifest.json";
import SectionPage from "../components/SectionPage.astro";
import type { PublicDocument } from "../types";
const documents = manifest.documents.filter((document) => document.section === "projects") as PublicDocument[];
---
<SectionPage
  section="projects"
  title="Projects"
  eyebrow="Projects"
  intro="Things I am building, things I have finished, and plans I still want to try."
  documents={documents}
  generatedAt={manifest.generatedAt}
/>
