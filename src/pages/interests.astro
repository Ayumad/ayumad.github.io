---
import manifest from "../generated/manifest.json";
import SectionPage from "../components/SectionPage.astro";
import type { PublicDocument } from "../types";
const documents = manifest.documents.filter((document) => document.section === "interests") as PublicDocument[];
---
<SectionPage
  section="interests"
  title="Interests"
  eyebrow="Interests"
  intro="Technology, audio, photography, philosophy, media, learning, and other things I keep coming back to."
  documents={documents}
  generatedAt={manifest.generatedAt}
/>
