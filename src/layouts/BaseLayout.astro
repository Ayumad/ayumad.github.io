---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  generatedAt?: string;
  image?: string;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
  generatedAt,
  image = "https://ayumad.github.io/og.png",
} = Astro.props;
const pageTitle = title === "Home" ? "Ayush’s knowledge" : `${title} — Ayush’s knowledge`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040707" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Ayush’s blog and knowledge" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        const incomingTheme = params.get("theme");
        const incomingRenderer = params.get("renderer");
        const themes = ["light", "dark"];
        const renderers = ["ascii", "dither", "glitch", "particles", "crt"];
        const storedTheme = localStorage.getItem("ayumad-theme");
        const storedRenderer = localStorage.getItem("ayumad-renderer");
        const preferred = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        const theme = themes.includes(incomingTheme) ? incomingTheme : themes.includes(storedTheme) ? storedTheme : preferred;
        const renderer = renderers.includes(incomingRenderer) ? incomingRenderer : renderers.includes(storedRenderer) ? storedRenderer : "ascii";
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.renderer = renderer;
        localStorage.setItem("ayumad-theme", theme);
        localStorage.setItem("ayumad-renderer", renderer);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <button class="mobile-menu" type="button" aria-controls="site-sidebar" aria-expanded="false" data-menu-open>
      <span>AYUMAD/KNOWLEDGE</span><strong>Menu</strong>
    </button>
    <Sidebar currentPath={currentPath} />
    <div class="page-shell">
      <main id="main-content"><slot /></main>
      {generatedAt && (
        <div class="sync-footer">
          <span class="signal" aria-hidden="true"></span>
          Last synchronized <time datetime={generatedAt}>{new Date(generatedAt).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" })}</time>
        </div>
      )}
    </div>
    <div class="menu-scrim" data-menu-close></div>
    <div class="mode-transition" aria-hidden="true"></div>
    <script>
      const root = document.documentElement;
      const sidebar = document.querySelector("#site-sidebar");
      const opener = document.querySelector("[data-menu-open]");
      const rendererNames: Record<string, string> = {
        ascii: "ASCII",
        dither: "Dither",
        glitch: "Glitch",
        particles: "Particles",
        crt: "CRT+",
      };
      const syncContext = () => {
        const theme = root.dataset.theme || "dark";
        const renderer = root.dataset.renderer || "ascii";
        document.querySelectorAll("[data-portfolio-link]").forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          const url = new URL(link.href);
          url.searchParams.set("theme", theme);
          url.searchParams.set("renderer", renderer);
          link.href = url.toString();
        });
        document.querySelectorAll("[data-renderer-value]").forEach((button) => {
          const active = button.getAttribute("data-renderer-value") === renderer;
          button.setAttribute("aria-pressed", String(active));
        });
        const label = document.querySelector("[data-renderer-label]");
        if (label) label.textContent = rendererNames[renderer] || "ASCII";
      };
      const announceModeChange = () => {
        root.classList.remove("mode-changing");
        requestAnimationFrame(() => root.classList.add("mode-changing"));
        window.setTimeout(() => root.classList.remove("mode-changing"), 620);
      };
      const closeMenu = () => {
        sidebar?.classList.remove("open");
        root.classList.remove("menu-open");
        opener?.setAttribute("aria-expanded", "false");
      };
      opener?.addEventListener("click", () => {
        sidebar?.classList.add("open");
        root.classList.add("menu-open");
        opener.setAttribute("aria-expanded", "true");
      });
      document.querySelectorAll("[data-menu-close]").forEach((button) => button.addEventListener("click", closeMenu));
      addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          location.href = "/explore/#search";
        }
      });
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        localStorage.setItem("ayumad-theme", next);
        syncContext();
      });
      document.querySelectorAll("[data-renderer-value]").forEach((button) => {
        button.addEventListener("click", () => {
          const next = button.getAttribute("data-renderer-value");
          if (!next || next === root.dataset.renderer) return;
          root.dataset.renderer = next;
          localStorage.setItem("ayumad-renderer", next);
          syncContext();
          announceModeChange();
        });
      });
      syncContext();
    </script>
  </body>
</html>
