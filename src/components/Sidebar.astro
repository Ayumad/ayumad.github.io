---
const { currentPath = "/" } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/systems/", label: "Systems" },
  { href: "/interests/", label: "Interests" },
  { href: "/library/", label: "Notes" },
  { href: "/timeline/", label: "Timeline" },
  { href: "/about/", label: "About" },
];
---

<aside class="sidebar" id="site-sidebar">
  <div class="sidebar-top">
    <a class="wordmark" href="/" aria-label="Ayush knowledge base home">
      <span>AYUMAD</span><strong>/KNOWLEDGE</strong>
    </a>
    <button class="menu-close" type="button" aria-label="Close navigation" data-menu-close>×</button>
  </div>
  <nav class="site-network" aria-label="Ayumad sites">
    <a href="https://ayumad.me/#/" data-portfolio-link>Portfolio <span aria-hidden="true">↗</span></a>
    <a class:list={{ active: currentPath.startsWith("/blog/") }} href="/blog/">Blog</a>
    <a class:list={{ active: !currentPath.startsWith("/blog/") }} href="/">Knowledge</a>
  </nav>
  <p class="sidebar-intro">Published essays and the public layer of my Obsidian vault: projects, systems, interests, and working notes.</p>
  <nav aria-label="Primary navigation">
    {nav.map((item) => (
      <a class:list={["nav-link", { active: item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href) }]} href={item.href}>
        {item.label}
      </a>
    ))}
  </nav>
  <div class="sidebar-actions">
    <div class="renderer-control">
      <div class="renderer-control-label">
        <span>Visual mode</span>
        <output data-renderer-label>ASCII</output>
      </div>
      <div class="renderer-options" aria-label="Visual mode">
        <button type="button" data-renderer-value="ascii" aria-label="Use ASCII visual mode" aria-pressed="false">A</button>
        <button type="button" data-renderer-value="dither" aria-label="Use dither visual mode" aria-pressed="false">D</button>
        <button type="button" data-renderer-value="glitch" aria-label="Use glitch visual mode" aria-pressed="false">G</button>
        <button type="button" data-renderer-value="particles" aria-label="Use particles visual mode" aria-pressed="false">P</button>
        <button type="button" data-renderer-value="crt" aria-label="Use CRT+ visual mode" aria-pressed="false">C+</button>
      </div>
    </div>
    <a class="search-link" href="/explore/"><kbd>⌘</kbd><kbd>K</kbd><span>Search</span></a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
      <span aria-hidden="true">◐</span> Theme
    </button>
  </div>
  <footer>
    <a href="https://ayumad.me/#/" data-portfolio-link>← Return to portfolio</a>
    <p>Part of ayumad.me · Updated from Obsidian.</p>
  </footer>
</aside>
